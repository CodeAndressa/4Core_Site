# ====================================
# 4Core — Variáveis de Ambiente
# ====================================
# Copie este arquivo como .env.local e preencha com os valores reais.
# NUNCA commite o .env.local no repositório.

# SMTP — Configuração do servidor de e-mail Hostinger
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=comercial@4core.site
SMTP_PASS=<sua-senha-aqui>

# E-mail de destino para os leads do formulário
CONTACT_EMAIL=comercial@4core.site

# WhatsApp — Número com código do país (sem + ou espaços)
# Ver src/data/contacts.ts para todos os números comerciais
NEXT_PUBLIC_WHATSAPP_NUMBER=5541988035657
NEXT_PUBLIC_WHATSAPP_MESSAGE=Olá! Gostaria de falar com um especialista da 4Core.

# URL do site (usada para SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://4core.com.br

# Supabase — Banco de dados, CRM e Auth
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Groq API — Chatbot SDR
GROQ_API_KEY=sua-groq-api-key-aqui
