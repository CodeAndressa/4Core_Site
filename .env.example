# ====================================
# 4Core — Variáveis de Ambiente
# ====================================
# Copie este arquivo como .env.local e preencha com os valores reais.
# NUNCA commite o .env.local no repositório.

# SMTP — Configuração do servidor de e-mail
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=contato@4core.com.br
SMTP_PASS=sua-senha-segura

# E-mail de destino para os leads do formulário
CONTACT_EMAIL=contato@4core.com.br

# WhatsApp — Número com código do país (sem + ou espaços)
NEXT_PUBLIC_WHATSAPP_NUMBER=5511984295040
NEXT_PUBLIC_WHATSAPP_MESSAGE=Olá! Gostaria de falar com um especialista da 4Core.

# URL do site (usada para SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://4core.com.br

# Supabase — Banco de dados e CRM
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui
